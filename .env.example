# ==============================================================================
# WAT-PROFILE ROOT DOCKER COMPOSE CONFIGURATION (.env.example)
# คู่มือการตั้งค่าตัวแปรหลักสำหรับ Docker Compose และ Caddy SSL Reverse Proxy
# ==============================================================================
# คำแนะนำการใช้งาน:
# 1. คัดลอกไฟล์นี้ไปเป็น `.env` ที่โฟลเดอร์ root ของโปรเจกต์: cp .env.example .env
# 2. แก้ไขชื่อโดเมนและรหัสผ่านฐานข้อมูลให้ตรงกับการใช้งานจริง
# 3. รันระบบด้วยคำสั่ง: make prod-up (หรือ docker compose -f docker-compose.prod.yml up -d)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. การตั้งค่าโดเมนหลักและระบบความปลอดภัย SSL (DOMAIN & SSL CONFIG)
# ------------------------------------------------------------------------------
# โดเมนหลักของเว็บไซต์ (Caddy Reverse Proxy จะนำชื่อโดเมนนี้ไปขอใบรับรอง SSL อัตโนมัติจาก Let's Encrypt)
# - ตัวอย่างสำหรับทดสอบในเครื่อง: DOMAIN=localhost
# - ตัวอย่างสำหรับ Production: DOMAIN=watloungporsai.de
DOMAIN=localhost


# ------------------------------------------------------------------------------
# 2. ข้อมูลฐานข้อมูล POSTGRESQL ภายใน DOCKER CONTAINER
# ------------------------------------------------------------------------------
# ชื่อฐานข้อมูลหลักของระบบ
POSTGRES_DB=wat_profile

# ชื่อผู้ใช้ฐานข้อมูล (ค่าเริ่มต้น: postgres)
POSTGRES_USER=postgres

# รหัสผ่านของ PostgreSQL (ใน Production ต้องตั้งรหัสผ่านที่ปลอดภัยและรัดกุม)
# *หมายเหตุ*: ต้องตรงกับรหัสผ่านใน DATABASE_URL ของ backend/.env
POSTGRES_PASSWORD=postgres_secure_password_replace_in_production


# ------------------------------------------------------------------------------
# 3. ตัวแปรส่งผ่านขณะ BUILD FRONTEND CONTAINER (BUILD-TIME ARGUMENTS)
# ------------------------------------------------------------------------------
# ค่าเหล่านี้จะถูกนำไป compile ฝังใน Next.js ขณะที่ docker compose ทำการ build image

# URL ปลายทางของ Backend API ที่ Frontend จะเรียกใช้งาน
NEXT_PUBLIC_API_URL=https://watloungporsai.de

# โดเมน Cloudflare R2 ที่อนุญาตให้แสดงรูปภาพ (ตรงกับ R2_PUBLIC_URL ใน backend/.env)
NEXT_PUBLIC_MEDIA_ALLOWED_ORIGINS=https://pub-your-id.r2.dev

# สถานะการเปิด/ปิดฟีเจอร์สมาชิกและเว็บบอร์ด (false เป็นค่าเริ่มต้นที่ปลอดภัย)
NEXT_PUBLIC_PUBLIC_ACCOUNT_AUTH_ENABLED=false
NEXT_PUBLIC_COMMUNITY_ENABLED=false
