{
  "name": "temp-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:admin-theme": "node scripts/check-admin-theme-tokens.mjs",
    "test": "NODE_ENV=development tsx --test 'src/**/*.test.ts' 'src/**/*.test.tsx'",
    "test:all": "npm run test",
    "test:account": "tsx --test src/features/public/account/*.test.ts",
    "test:community": "tsx --test src/features/public/community/*.test.ts src/features/admin-community/*.test.ts",
    "test:calendar:dom": "NODE_ENV=development tsx --test src/features/calendar/ui/*.test.ts",
    "test:calendar": "npm run test:calendar:dom && NODE_ENV=development tsx --test src/features/calendar/*.test.ts src/features/calendar/*.test.tsx src/features/calendar/core/*.test.ts src/features/calendar/presets/*.test.ts src/features/calendar/adapters/*.test.ts src/features/calendar/ui/*.test.ts src/features/calendar/views/*.test.ts src/features/calendar/integrations/next/*.test.ts src/features/calendar/integrations/wat/*.test.tsx && NODE_ENV=development tsx 'src/app/[locale]/admin/calendar/_components/CalendarEntryDrawer.test.ts' && NODE_ENV=development tsx 'src/schemas/calendar-resource.schema.test.ts'",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.1",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-image": "3.29.2",
    "@tiptap/extension-link": "3.29.2",
    "@tiptap/extension-text-align": "3.29.2",
    "@tiptap/extension-text-style": "3.29.2",
    "@tiptap/html": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.13.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "framer-motion": "^12.28.1",
    "isomorphic-dompurify": "^2.36.0",
    "lucide-react": "^0.562.0",
    "next": "^16.1.6",
    "next-intl": "^4.7.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-datepicker": "^9.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.3",
    "react-easy-crop": "^6.2.3",
    "react-hook-form": "^7.71.2",
    "react-to-print": "^3.2.0",
    "tailwind-merge": "^3.4.0",
    "yet-another-react-lightbox": "^3.28.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "happy-dom": "^20.11.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "^0.35.0",
    "@tiptap/core": "$@tiptap/core",
    "@tiptap/pm": "$@tiptap/pm"
  }
}
