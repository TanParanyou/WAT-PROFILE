# ==============================================================================
# WAT-PROFILE FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# คู่มือการตั้งค่าตัวแปรสภาพแวดล้อมฝั่ง Frontend (Next.js App Router)
# ==============================================================================
# คำแนะนำการใช้งาน:
# - สำหรับพัฒนาในเครื่อง (Local Dev): คัดลอกไฟล์นี้ไปเป็น `frontend/.env.local`
# - สำหรับขึ้นเซิร์ฟเวอร์จริง (Production): คัดลอกไฟล์นี้ไปเป็น `frontend/.env`
#   (คำสั่ง: cp frontend/.env.example frontend/.env.local)
# ==============================================================================

# ------------------------------------------------------------------------------
# หมวดที่ 1: การเชื่อมต่อกับ BACKEND API และระบบ CMS (API ENDPOINT & CMS SOURCE)
# ------------------------------------------------------------------------------
# ที่อยู่ URL ของเซิร์ฟเวอร์ Backend Go API
# - ตอนพัฒนาในเครื่อง (Local Dev): "http://localhost:8080" (หรือพอร์ตที่รัน Backend ไว้)
# - ตอนขึ้น Production จริง: ต้องเป็นโดเมนที่มี HTTPS เสมอ เช่น "https://watloungporsai.de" หรือ "https://api.watloungporsai.de"
NEXT_PUBLIC_API_URL="http://localhost:8080"

# แหล่งที่มาของข้อมูลเนื้อหาหน้าเว็บ (Website CMS Data Source):
# - "api"  : (ค่ามาตรฐานที่แนะนำ) ดึงข้อมูลจริงจากฐานข้อมูลผ่าน Backend API
# - "mock" : ใช้ข้อมูลตัวอย่างภายในเครื่อง (ใช้เฉพาะตอนทดสอบ UI ขณะที่ Backend ยังไม่พร้อม)
NEXT_PUBLIC_WEBSITE_CMS_SOURCE="api"


# ------------------------------------------------------------------------------
# หมวดที่ 2: โดเมนรูปภาพที่อนุญาตและ Cloudflare R2 (MEDIA ALLOWED ORIGINS)
# ------------------------------------------------------------------------------
# รายชื่อ URL โดเมนภายนอกที่อนุญาตให้ระบบดาวน์โหลด ครอบตัด และแสดงรูปภาพได้ (คั่นด้วยเครื่องหมายจุลภาค)
# - ใน Production: ต้องระบุโดเมน Cloudflare R2 (ตรงกับ R2_PUBLIC_URL ใน Backend) อย่างน้อย 1 โดเมนที่เป็น HTTPS
# ตัวอย่าง:
#   NEXT_PUBLIC_MEDIA_ALLOWED_ORIGINS="https://pub-xxxxxxxxxxxx.r2.dev,https://media.watloungporsai.de"
NEXT_PUBLIC_MEDIA_ALLOWED_ORIGINS="http://localhost:9000"


# ------------------------------------------------------------------------------
# หมวดที่ 3: สวิตช์เปิด/ปิดฟีเจอร์หน้าเว็บไซต์ (FEATURE FLAGS)
# ------------------------------------------------------------------------------
# เปิด/ปิด การแสดงผลปุ่มเข้าสู่ระบบ/สมัครสมาชิกของประชาชนทั่วไปหน้าเว็บไซต์:
# - "false" : ซ่อนปุ่มเข้าสู่ระบบสมาชิกหน้าบ้าน (เหมาะสำหรับช่วงเปิดตัวเว็บไซต์ระยะแรก)
# - "true"  : แสดงปุ่มสมาชิกและเปิดให้ประชาชนลงทะเบียนบัญชีได้ (ต้องเปิดคู่กับ PUBLIC_ACCOUNT_AUTH_ENABLED ใน Backend)
NEXT_PUBLIC_PUBLIC_ACCOUNT_AUTH_ENABLED="false"

# เปิด/ปิด การแสดงผลเมนูเว็บบอร์ดถาม-ตอบธรรมะ (Community Q&A):
# - "false" : ปิดการแสดงผลเมนูเว็บบอร์ด
# - "true"  : แสดงผลเมนูเว็บบอร์ดสู่สาธารณะ (ต้องเปิดคู่กับ PUBLIC_COMMUNITY_READ_ENABLED ใน Backend)
NEXT_PUBLIC_COMMUNITY_ENABLED="false"
