# Resend (Email Service)
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Email Configuration
EMAIL_FROM=onboarding@resend.dev
CONTACT_EMAIL=your-email@example.com

# Admin Authentication & Website CMS Configuration
# For production and real data access, ensure SKIP_ADMIN_AUTH is "false" and CMS_SOURCE is "api"
NEXT_PUBLIC_SKIP_ADMIN_AUTH="false"
NEXT_PUBLIC_WEBSITE_CMS_SOURCE="api"

# Public Account Auth (production public accounts; separate from Admin auth)
# Enable the public-account UI surface. Keep disabled until acceptance is
# complete; production must enable backend + frontend flags together.
NEXT_PUBLIC_PUBLIC_ACCOUNT_AUTH_ENABLED="false"
# Backend API base URL used by the public account client.
NEXT_PUBLIC_API_URL="http://localhost:8082"
