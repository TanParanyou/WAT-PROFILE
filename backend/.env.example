# Server Configuration
PORT=8080
ENV=development

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/wat_profile?sslmode=disable
DB_AUTO_MIGRATE=true

# JWT
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://watloungporsai.de

# Admin Session (cookie-based Admin auth)
# Explicit origin allowlist for the Admin cookie endpoints. Wildcards are
# rejected; leave unset to fall back to ALLOWED_ORIGINS.
ADMIN_ALLOWED_ORIGINS=http://localhost:3000,https://watloungporsai.de
# Set true in production so the Admin refresh cookie is only sent over HTTPS.
ADMIN_COOKIE_SECURE=false
# How long an Admin session lives before the refresh credential must be re-issued.
ADMIN_SESSION_EXPIRY=24h
# Grace window for concurrent tabs presenting a rotated refresh credential.
ADMIN_SESSION_GRACE=30s

# Cloudflare R2 (S3-compatible storage)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-bucket.r2.dev

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Your App Name

# Admin User (for seeding)
ADMIN_EMAIL=admin@watloungporsai.de
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Wat Admin

# Public Account Auth (production public accounts; separate from Admin auth)
# Enable the backend public-account surface. Keep disabled until acceptance is
# complete; production must enable backend + frontend flags together.
PUBLIC_ACCOUNT_AUTH_ENABLED=false
# Origin of the Next.js public site (used for email links and safe redirects).
# Must be https in production.
PUBLIC_ACCOUNT_FRONTEND_URL=http://localhost:3000
# Google OAuth 2.0 client. GOOGLE_REDIRECT_URL must be a registered callback
# URL and https in production.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/accounts/google/callback
# Access token lifetime (short-lived). Default 15m.
AUTH_ACCESS_TOKEN_EXPIRY=15m
# Refresh session lifetime (rotating). Default 30d.
AUTH_REFRESH_TOKEN_EXPIRY=30d
# Email delivery: "capture" (local test sink, refuses ENV=production) or
# "resend" (transactional provider). "resend" requires the keys below.
AUTH_EMAIL_DELIVERY_MODE=capture
RESEND_API_KEY=re_your-resend-api-key
ACCOUNT_EMAIL_FROM=no-reply@watloungporsai.de
# Scoped rate limits (count per window; conservative defaults)
AUTH_REGISTER_LIMIT=5
AUTH_LOGIN_LIMIT=10
AUTH_VERIFY_RESEND_LIMIT=3
AUTH_FORGOT_PASSWORD_LIMIT=5
AUTH_REFRESH_LIMIT=60
AUTH_GOOGLE_LIMIT=20
