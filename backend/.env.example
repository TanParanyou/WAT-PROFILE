# ==============================================================================
# WAT-PROFILE BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# คู่มือการตั้งค่าตัวแปรสภาพแวดล้อมฝั่ง Backend (ภาษาไทยแบบละเอียด)
# ==============================================================================
# คำแนะนำการใช้งาน:
# 1. คัดลอกไฟล์นี้ไปเป็น `backend/.env` ด้วยคำสั่ง: cp backend/.env.example backend/.env
# 2. แก้ไขค่าตัวแปรให้ตรงกับการใช้งานจริง (ห้าม commit ไฟล์ .env ขึ้น Git เด็ดขาด)
# ==============================================================================

# ------------------------------------------------------------------------------
# หมวดที่ 1: การตั้งค่าเซิร์ฟเวอร์และสภาพแวดล้อม (SERVER & RUNTIME ENVIRONMENT)
# ------------------------------------------------------------------------------
# พอร์ตที่ Backend Go Fiber จะเปิดทำงานและรับ Request
# - Local Dev แนะนำ: 8080 หรือ 8082
# - Production แนะนำ: 8080 (ทำงานภายใน Container)
PORT=8080

# โหมดการทำงานของระบบ มี 3 ระดับ:
# - development : โหมดพัฒนาในเครื่อง (เปิดแสดง log ละเอียด, อนุญาต mock/capture email)
# - staging     : โหมดทดสอบเสมือนจริง (บังคับใช้ HTTPS)
# - production  : โหมดใช้งานจริง (บังคับใช้ HTTPS, ห้ามใช้ capture email, เข้มงวดเรื่องความปลอดภัยสูงสุด)
ENV=development


# ------------------------------------------------------------------------------
# หมวดที่ 2: การเชื่อมต่อฐานข้อมูล (DATABASE CONFIGURATION - PostgreSQL 16)
# ------------------------------------------------------------------------------
# URL สำหรับเชื่อมต่อไปยัง PostgreSQL Database
# รูปแบบ: postgresql://[ชื่อผู้ใช้]:[รหัสผ่าน]@[โฮสต์]:[พอร์ต]/[ชื่อฐานข้อมูล]?sslmode=[โหมด SSL]
# - Local Dev   : postgresql://postgres:password@localhost:5432/wat_profile?sslmode=disable
# - Docker Prod : postgresql://postgres:postgres_secure_password@postgres:5432/wat_profile?sslmode=disable
DATABASE_URL=postgresql://postgres:password@localhost:5432/wat_profile?sslmode=disable

# การสร้าง/อัปเดตตารางฐานข้อมูลอัตโนมัติ (AutoMigrate):
# - true  : อนุญาตให้ GORM สร้างตารางเอง (ไม่แนะนำใน Production)
# - false : (แนะนำ) ปิดไว้เสมอ และใช้ระบบ SQL Versioned Migrations ผ่านคำสั่ง `make prod-migrate`
DB_AUTO_MIGRATE=false


# ------------------------------------------------------------------------------
# หมวดที่ 3: ระบบความปลอดภัยและการยืนยันตัวตนแอดมิน (AUTH & ADMIN SESSION)
# ------------------------------------------------------------------------------
# กุญแจลับสำหรับเข้ารหัสและถอดรหัส JWT Access Token
# *คำเตือน*: ใน Production ต้องสุ่มสร้างใหม่อย่างน้อย 32 ตัวอักษร และห้ามเปิดเผยเด็ดขาด
JWT_SECRET=your-super-secret-key-change-this-in-production-min-32-chars

# ระยะเวลาหมดอายุของ JWT Access Token (เช่น 15m = 15 นาที, 1h = 1 ชั่วโมง)
JWT_ACCESS_EXPIRY=15m

# ระยะเวลาหมดอายุของ JWT Refresh Token (เช่น 7d = 7 วัน, 30d = 30 วัน)
JWT_REFRESH_EXPIRY=7d

# รายชื่อโดเมนต้นทางที่อนุญาตให้ติดต่อกับ API ได้ (CORS Allowlist) คั่นด้วยจุลภาค (ห้ามใส่เครื่องหมาย / ท้าย URL)
# เช่น: http://localhost:3000,http://localhost:3002,https://watloungporsai.de
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,https://watloungporsai.de

# รายชื่อโดเมนที่อนุญาตให้ส่งและรับ Admin Refresh Cookie ได้
ADMIN_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,https://watloungporsai.de

# การตั้งค่าความปลอดภัยของ Cookie สำหรับผู้ดูแลระบบ:
# - false : สำหรับ Local Dev ที่รันผ่าน HTTP ธรรมดา
# - true  : สำหรับ Production ที่รันผ่าน HTTPS เพื่อป้องกันการดักจับ Cookie
ADMIN_COOKIE_SECURE=false

# อายุของเซสชันการเข้าสู่ระบบของแอดมินก่อนที่จะต้องล็อกอินใหม่ (ค่าเริ่มต้น: 12h = 12 ชั่วโมง)
ADMIN_SESSION_EXPIRY=12h

# ระยะเวลาผ่อนปรน (Grace Window) กรณีที่เปิดหลายแท็บพร้อมกันแล้วเกิดการ refresh token ซ้อน (ค่าเริ่มต้น: 30s)
ADMIN_SESSION_GRACE=30s


# ------------------------------------------------------------------------------
# หมวดที่ 4: การจัดเก็บรูปภาพและไฟล์สื่อ (STORAGE & MEDIA - Cloudflare R2)
# ------------------------------------------------------------------------------
# ข้อมูลการเชื่อมต่อพื้นที่จัดเก็บไฟล์ Cloudflare R2 (S3-Compatible)
# ใช้สำหรับเก็บรูปภาพข่าวสาร, รูปพระสงฆ์, แกลเลอรี, และหลักฐานการโอนเงินบริจาค
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=wat-profile-media

# โดเมนสาธารณะสำหรับแสดงรูปภาพสู่หน้าเว็บไซต์ (ต้องเป็น HTTPS)
# เช่น: https://pub-xxxxxxxxxxxx.r2.dev หรือ https://media.watloungporsai.de
R2_PUBLIC_URL=https://your-bucket.r2.dev


# ------------------------------------------------------------------------------
# หมวดที่ 5: บัญชีผู้ดูแลระบบสูงสุดเริ่มต้น (INITIAL SUPER ADMIN SEEDING)
# ------------------------------------------------------------------------------
# บัญชี Super Admin ที่จะถูกสร้างขึ้นอัตโนมัติเมื่อรันคำสั่ง Seed ข้อมูลเริ่มต้น (`make prod-seed`)
# อีเมลสำหรับเข้าสู่ระบบ Admin Panel ครั้งแรก
ADMIN_EMAIL=admin@watloungporsai.de
# รหัสผ่านเริ่มต้น (แนะนำให้เปลี่ยนรหัสผ่านทันทีหลังล็อกอินเข้าสู่ระบบสำเร็จ)
ADMIN_PASSWORD=changeme123
# ชื่อที่แสดงของผู้ดูแลระบบ
ADMIN_NAME=Wat Super Admin


# ------------------------------------------------------------------------------
# หมวดที่ 6: ระบบส่งอีเมลและการแจ้งเตือน (EMAIL DELIVERY & WORKER)
# ------------------------------------------------------------------------------
# รูปแบบการส่งอีเมลของระบบ:
# - capture : จำลองการส่งโดยพิมพ์เนื้อหาอีเมลลง Console/Log (ใช้เฉพาะตอน Dev ในเครื่อง)
# - resend  : ส่งอีเมลจริงผ่านบริการ Resend API (แนะนำสำหรับ Production)
AUTH_EMAIL_DELIVERY_MODE=capture

# API Key ที่ได้จากแดชบอร์ดของ Resend (จำเป็นต้องใส่หากเลือก AUTH_EMAIL_DELIVERY_MODE=resend)
# สมัครและรับคีย์ได้ที่: https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here

# อีเมลผู้ส่งสำหรับการแจ้งเตือนระบบบัญชี, การลงทะเบียนกิจกรรม, และใบอนุโมทนาบัตร
ACCOUNT_EMAIL_FROM=no-reply@watloungporsai.de

# อีเมลผู้ส่งสำหรับการตอบกลับข้อความติดต่อสอบถาม
CONTACT_EMAIL_FROM=contact@watloungporsai.de

# อีเมลของเจ้าหน้าที่วัด/สำนักงาน ที่จะได้รับแจ้งเตือนเมื่อมีคนส่งข้อความผ่านหน้าเว็บ
CONTACT_NOTIFICATION_TO=office@watloungporsai.de

# เวอร์ชันของข้อกำหนดความเป็นส่วนตัวในการลงทะเบียนกิจกรรม
EVENT_REGISTRATION_PRIVACY_NOTICE_VERSION=2026-08

# --- การตั้งค่า SMTP สำรอง (กรณีไม่ใช้ Resend แต่ต้องการใช้ Mail Server ของวัดหรือ Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Wat Loungpor Sai


# ------------------------------------------------------------------------------
# หมวดที่ 7: ระบบสมาชิกทั่วไปหน้าเว็บและ Google Login (PUBLIC ACCOUNT AUTH)
# ------------------------------------------------------------------------------
# เปิด/ปิด ระบบสมาชิกสำหรับประชาชนทั่วไปหน้าเว็บไซต์ (ค่าเริ่มต้น: false เพื่อความปลอดภัย)
# *หมายเหตุ*: หากเปิดใช้งาน ต้องเปิดควบคู่กับฝั่ง Frontend เสมอ
PUBLIC_ACCOUNT_AUTH_ENABLED=false

# URL หน้าบ้านของเว็บไซต์ (ใช้สร้างลิงก์ยืนยันตัวตนในอีเมล และ redirect หลังล็อกอิน)
PUBLIC_ACCOUNT_FRONTEND_URL=http://localhost:3000
PUBLIC_ACCOUNT_ALLOWED_ORIGINS=http://localhost:3000

# ข้อมูล Google OAuth 2.0 Client (สำหรับปุ่มเข้าสู่ระบบด้วย Google)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# URL Callback ที่ลงทะเบียนไว้ใน Google Cloud Console
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/accounts/google/callback
# กุญแจลับสำหรับเข้ารหัส HMAC ตรวจสอบความถูกต้องของ OAuth Flow Cookie
GOOGLE_FLOW_SECRET=your-flow-signing-secret-min-32-chars

# อายุ Token ของสมาชิกทั่วไป
AUTH_ACCESS_TOKEN_EXPIRY=15m
AUTH_REFRESH_TOKEN_EXPIRY=30d


# ------------------------------------------------------------------------------
# หมวดที่ 8: ระบบเว็บบอร์ดสนทนาธรรมและถาม-ตอบ (COMMUNITY Q&A MODULE)
# ------------------------------------------------------------------------------
# เปิด/ปิด ให้ประชาชนทั่วไปสามารถอ่านคำถาม-คำตอบในกระดานสนทนาได้
PUBLIC_COMMUNITY_READ_ENABLED=false
# เปิด/ปิด ให้สมาชิกที่ยืนยันตัวตนแล้วสามารถตั้งกระทู้หรือตอบคำถามได้
PUBLIC_COMMUNITY_WRITE_ENABLED=false
# เปิด/ปิด การส่งอีเมลแจ้งเตือนเมื่อมีผู้มาตอบกระทู้
COMMUNITY_EMAIL_ENABLED=false


# ------------------------------------------------------------------------------
# หมวดที่ 9: การจำกัดจำนวนคำขอเพื่อความปลอดภัย (RATE LIMITS & SECURITY)
# ------------------------------------------------------------------------------
# จำกัดจำนวนครั้งสูงสุดที่สามารถทำรายการได้ในแต่ละช่วงเวลา เพื่อป้องกันการยิงสแปม (Brute Force / DDoS)
# จำนวนครั้งสูงสุดในการสมัครสมาชิกใหม่ต่อชั่วโมง
AUTH_REGISTER_LIMIT=5
# จำนวนครั้งสูงสุดในการพยายามล็อกอินต่อ 15 นาที
AUTH_LOGIN_LIMIT=10
# จำนวนครั้งสูงสุดในการขอกดส่งอีเมลยืนยันตัวตนซ้ำ
AUTH_VERIFY_RESEND_LIMIT=3
# จำนวนครั้งสูงสุดในการขอกดรีเซ็ตรหัสผ่าน
AUTH_FORGOT_PASSWORD_LIMIT=5
# จำนวนครั้งสูงสุดในการต่ออายุ Refresh Token ต่อชั่วโมง
AUTH_REFRESH_LIMIT=60
# จำนวนครั้งสูงสุดในการล็อกอินผ่าน Google
AUTH_GOOGLE_LIMIT=20
# จำนวนครั้งสูงสุดในการเปลี่ยนรูปโปรไฟล์
AUTH_AVATAR_UPLOAD_LIMIT=12
# จำนวนครั้งสูงสุดในการแก้ไขข้อมูลสำคัญ (เช่น เปลี่ยนรหัสผ่าน, ปิดบัญชี)
AUTH_SENSITIVE_MUTATION_LIMIT=5

# ข้อจำกัดการใช้งานระบบ Community (จำนวนครั้ง)
COMMUNITY_QUESTION_LIMIT=5
COMMUNITY_QUESTION_DAILY_LIMIT=20
COMMUNITY_ANSWER_LIMIT=20
COMMUNITY_COMMENT_LIMIT=30
COMMUNITY_VOTE_LIMIT=120
COMMUNITY_REPORT_LIMIT=10
COMMUNITY_SEARCH_LIMIT=60
